# >>> FILL ME IN <<<
# The game slug from your Bloxity developer dashboard.
# Copy this file to `.env` (or `.env.local`) and replace the placeholder.
VITE_GAME_SLUG=MY_GAME_SLUG

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Game server: leaderboards, account saves and multiplayer lobbies (Colyseus).
# Defaults to http://localhost:3000 when unset; lobbies use the same host over ws://.
VITE_API_URL=http://localhost:3000
# Only if the lobby WebSocket lives somewhere else than VITE_API_URL:
# VITE_WS_URL=ws://localhost:3000

