# Production build (npm run build) for Bloxity Legion hosting.
# Game server: REST + account saves + leaderboard. The dev channel uses
# https://speed-shinobi-escape.dev.host.bloxity.io (the deploy workflow sets it).
VITE_API_URL=https://speed-shinobi-escape.host.bloxity.io
# Lobbies go through the Legion matchmaker (play.bloxity.io) for this game id.
VITE_LEGION_GAME_ID=speed-shinobi-escape
VITE_GAME_SLUG=speed-shinobi-escape
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io
